#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 6

#include <behaviors/rgbled_widget.dtsi>  // needed to use the behaviors
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {
        macro_press: macro_press {
            compatible = "zmk,behavior-macro-press";
            label = "MACRO_PRESS";
        };

        macro_tap: macro_tap {
            compatible = "zmk,behavior-macro-tap";
            label = "MACRO_TAP";
        };

        macro_release: macro_release {
            compatible = "zmk,behavior-macro-release";
            label = "MACRO_RELEASE";
        };
    };

    macros {
        zoom_in: zoom_in {
            compatible = "zmk,behavior-macro";
            bindings = <
                &macro_press &kp LEFT_CONTROL
                &macro_tap &msc SCRL_UP
                &macro_release &kp LEFT_CONTROL
            >;
        };

        zoom_out: zoom_out {
            compatible = "zmk,behavior-macro";
            bindings = <
                &macro_press &kp LEFT_CONTROL
                &macro_tap &msc SCRL_DOWN
                &macro_release &kp LEFT_CONTROL
            >;
        };
    };
};

/ {
    combos { compatible = "zmk,combos"; };
   
    keymap {
        compatible = "zmk,keymap";

        Default_Layer {
            bindings = <
                &kp Q           &kp W         &kp E         &kp R               &kp T                      &kp Y      &kp U       &kp I          &kp O             &kp P
                &kp A           &kp S         &kp D         &kp F               &kp G                      &kp H      &kp J       &kp K          &kp L             &lt 1 SEMICOLON
                &kp Z           &kp X         &kp C         &kp V               &kp B        &kp LCTRL     &kp N      &kp M       &kp COMMA      &kp PERIOD        &kp SLASH
                &kp LEFT_SHIFT  &kp LEFT_ALT  &kp LEFT_GUI  &lt 2 LS(CAPSLOCK)  &lt 1 SPACE  &lt 3 DELETE  &kp ENTER  &kp ESCAPE  &kp BACKSPACE  &kp LEFT_BRACKET  &lt 4 RIGHT_BRACKET
            >;
        };

        Mouse_Layer {
            bindings = <
                &trans            &trans          &trans     &trans     &trans             &trans  &trans    &mkp MB4  &mkp MB5  &kp MINUS
                &kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans     &trans     &trans             &trans  &mkp MB1  &mkp MB3  &mkp MB2  &kp BACKSLASH
                &kp LC(Z)         &kp LC(X)       &kp LC(C)  &kp LC(V)  &kp LC(Y)  &trans  &trans  &trans    &zoom_in   &zoom_out   &trans
                &trans            &trans          &trans     &trans     &trans     &trans  &trans  &trans    &trans    &trans    &trans
            >;
        };

        Function_Layer {
            bindings = <
                &kp AT_SIGN  &kp HASH        &kp DOLLAR  &kp PERCENT      &kp CARET          &kp AMPERSAND  &kp ASTERISK  &kp LEFT_PARENTHESIS  &kp RIGHT_PARENTHESIS  &kp EQUAL
                &kp LCTRL    &kp LEFT_SHIFT  &kp TAB     &kp LEFT_ALT     &kp LWIN           &kp HOME       &kp LEFT      &kp UP_ARROW          &kp DOWN               &kp RIGHT
                &trans       &trans          &kp TILDE   &kp EXCLAMATION  &trans     &trans  &kp END        &trans        &kp LESS_THAN         &kp GREATER_THAN       &kp SINGLE_QUOTE
                &trans       &trans          &trans      &trans           &trans     &trans  &trans         &trans        &trans                &trans                 &trans
            >;
        };

        Num_Layer {
            bindings = <
                &kp LC(LA(DEL))  &trans        &kp LG(E)       &kp LG(R)        &trans                  &kp PLUS      &kp N7        &kp N8        &kp N9            &kp MINUS
                &kp TAB          &kp F2        &kp F4          &kp F8           &kp F10                 &kp ASTERISK  &kp NUMBER_4  &kp N5        &kp NUMBER_6      &kp COLON
                &msc SCRL_LEFT   &msc SCRL_UP  &msc SCRL_DOWN  &msc SCRL_RIGHT  &trans   &kp LS(LG(S))  &kp N0        &kp NUMBER_1  &kp NUMBER_2  &kp NUMBER_3      &kp SLASH
                &trans           &trans        &trans          &trans           &trans   &trans         &kp PERIOD    &kp EQUAL     &kp COMMA     &kp LEFT_BRACKET  &kp RIGHT_BRACKET
            >;
        };

        Setting_Layer {
            bindings = <
                &trans  &trans  &trans  &trans  &trans          &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4
                &trans  &trans  &trans  &trans  &trans          &trans        &trans        &trans        &trans        &trans
                &trans  &trans  &trans  &trans  &trans  &trans  &trans        &trans        &trans        &trans        &bt BT_CLR
                &trans  &trans  &trans  &trans  &trans  &trans  &bootloader   &trans        &sys_reset    &trans        &trans
            >;
        };
    };
};
