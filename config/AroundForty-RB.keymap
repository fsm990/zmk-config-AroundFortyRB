#define ZMK_POINTING_DEFAULT_SCRL_VAL 100
#define MOUSE 6

#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

/ {
    behaviors {


    };

    macros {
        





    keymap {
        compatible = "zmk,keymap";




layer_0 {
         bindings = <

&kp Q             &kp W         &kp E         &kp R           &kp T                        &kp Y      &kp U       &kp I          &kp O             &kp P
&kp A             &kp S         &kp D         &kp F           &kp G                        &kp H      &kp J       &kp K          &kp L             &lt 1 SEMICOLON
&kp Z             &kp X         &kp C         &kp V           &kp B        &kp LEFT_SHIFT  &kp N      &kp M       &kp COMMA      &kp PERIOD        &kp SLASH
&kp LEFT_CONTROL  &kp LEFT_ALT  &kp LEFT_WIN  &lt 2 LS(CAPS)  &lt 1 SPACE  &lt 3 DELETE    &kp ENTER  &kp ESCAPE  &kp BACKSPACE  &kp LEFT_BRACKET  &kp RIGHT_BRACKET
>;};layer_1 {
         bindings = <

&trans            &trans          &trans     &trans     &trans                     &trans  &trans    &mkp MB4  &mkp MB5  &kp MINUS
&kp LEFT_CONTROL  &kp LEFT_SHIFT  &trans     &trans     &trans                     &trans  &mkp MB1  &mkp MB3  &mkp MB2  &kp NON_US_BACKSLASH
&kp LC(Z)         &kp LC(X)       &kp LC(C)  &kp LC(V)  &kp LC(Y)  &kp LEFT_SHIFT  &trans  &trans    &trans    &trans    &trans
&trans            &trans          &trans     &trans     &trans     &trans          &trans  &trans    &trans    &trans    &trans
>;};layer_2 {
         bindings = <

&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
>;};layer_3 {
         bindings = <

&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
>;};layer_4 {
         bindings = <

&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans          &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
&trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans  &trans
>;};
    };
};
